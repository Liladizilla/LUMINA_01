# =============================================================================
# LUMINA STUDIO - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual API keys.
# IMPORTANT: Never commit .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google AI (Gemini) API Key
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
# This key is used for:
#   - AI image generation
#   - Video analysis
#   - Audio transcription
#   - Text-to-speech
#   - Complex reasoning tasks
#
# SECURITY NOTE: This is a client-side app. For production, we recommend
# using a backend proxy to protect your API key. The key here is exposed
# to the client browser.
VITE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CLOUD_SYNC=false

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration (for future cloud features)
# -----------------------------------------------------------------------------
# DATABASE_URL=your_database_url_here
# AUTH_SECRET=your_auth_secret_here

# -----------------------------------------------------------------------------
# Third-Party Services (for future cloud features)
# -----------------------------------------------------------------------------
# Cloud storage (AWS S3, Cloudflare R2, etc.)
# STORAGE_BUCKET=your_bucket_name
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key

# CDN for media delivery
# CDN_URL=your_cdn_url_here

