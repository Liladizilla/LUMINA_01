{
  "name": "lumina-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "turbo": "turbo",
    "dev:desktop": "turbo run dev --filter=desktop",
